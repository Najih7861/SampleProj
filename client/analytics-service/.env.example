# Copy this file to `.env` and adjust for your environment.
# Defaults below match the .NET API's appsettings.json for local dev, so the
# service runs out of the box against the same database and validates the same
# JWTs the .NET backend issues. Override these in any non-dev environment.

# Same database the .NET API uses (read-only access is all this service needs).
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/tourpackages

# MUST match the .NET API's "Jwt" section exactly, or tokens will be rejected.
# (If you rotate the .NET "Jwt:Key", update this value to match.)
JWT_KEY=Ts/YwXwaSi3zu/UgSbxIteT/FKZyay8q8F3jpTM2CSM=
JWT_ISSUER=WanderlustTours
JWT_AUDIENCE=WanderlustToursClient
JWT_ALG=HS256

# Origins allowed to call this service directly (the React dev server).
CORS_ORIGINS=http://localhost:5173
